    echo "@@@@@@@@@...@@@@@@@@@@@@@@@@@@...@@@@@@@"
    echo "@@@@@@@@..@@@@@@@@@@@@@@@@@@@@@@..@@@@@@"
    echo "@@@@@@...@................@@@@@@@..@@@@@"
    echo "@@@@@@..@@.......@@.......@@@@@@@@..@@@@"
